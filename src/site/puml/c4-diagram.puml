' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

title Machai MCP Server — C4 Component Diagram

System_Ext(mcpClient, "MCP Client", "IDE, AI assistant, or other MCP consumer")
System_Ext(configuration, "Configuration Files", "mcp-server.properties selects custom_configuration; mcp.properties is the default; --config overrides the selected file")
System_Ext(projectWorkspace, "Project Workspace", "Directory supplied with --projectDir or resolved by functions from request parameters")

' External components are in-process dependencies, not remote services.
Component_Ext(functionTools, "Machai Tool Framework", "Java library", "FunctionToolsLoader registers enabled functions; ToolFunction executes tools, prompts, and resources")

Container_Boundary(machaiServer, "Machai MCP Server (Java process)") {
  Component(entryPoint, "McpServer", "Java", "Parses CLI options; loads PropertiesConfigurator; selects, configures, and starts one transport server")

  ' Group shared implementation classes by architectural responsibility.
  Component(serverSupport, "Shared Server Support", "AbstractMcpServer / AbstractHttpMcpServer", "Stores project directory; reads enabledTools; defines lifecycle hooks; mounts HTTP transport in embedded Jetty")
  Component(stdioServer, "StdioMcpServer", "Java / MCP Java SDK", "Builds single-session STDIO server; registers tools and prompts; closes server on JVM shutdown")
  Component(statelessServer, "HttpStatelessMcpServer", "Java / MCP Java SDK", "Builds stateless HTTP server; registers tools, prompts, and resources")
  Component(streamableServer, "HttpStreamableMcpServer", "Java / MCP Java SDK", "Builds session-aware streamable HTTP server; registers tools and prompts")

  Component(adapterCore, "Shared Tool and Prompt Adaptation", "GenericGenaiAdapter / AbstractPromptGenaiAdapter", "Creates MCP schemas and invocation handlers; passes configuration and workspace to functions; maps results, errors, and prompt roles")
  Component(transportAdapters, "Transport-specific Adapters", "StdioGenaiAdapter / HttpStatelessGenericGenaiAdapter / HttpStreamableGenericGenaiAdapter", "Creates transport-specific specifications; stateless adapter adds resource handlers; streamable adapter adds prompt session identifiers")
}

Rel(entryPoint, configuration, "Loads selected properties via PropertiesConfigurator")
Rel(entryPoint, stdioServer, "Selects when --port is absent")
Rel(entryPoint, statelessServer, "Selects with --port without --session")
Rel(entryPoint, streamableServer, "Selects with --port --session")
Rel(entryPoint, serverSupport, "Sets workspace, registers tools, and starts selected server")

Rel(stdioServer, serverSupport, "Uses shared configuration and lifecycle contract")
Rel(statelessServer, serverSupport, "Uses shared configuration and Jetty startup")
Rel(streamableServer, serverSupport, "Uses shared configuration and Jetty startup")

Rel(stdioServer, transportAdapters, "Creates STDIO adapter; registers its specifications")
Rel(statelessServer, transportAdapters, "Creates stateless adapter; registers its specifications")
Rel(streamableServer, transportAdapters, "Creates streamable adapter; registers its specifications")
Rel(transportAdapters, adapterCore, "Uses shared schema and handler implementation")

Rel(stdioServer, functionTools, "Loads enabled functions into STDIO adapter")
Rel(statelessServer, functionTools, "Loads enabled functions into stateless adapter")
Rel(streamableServer, functionTools, "Loads enabled functions into streamable adapter")
Rel(adapterCore, functionTools, "Invokes tool and prompt functions with workspace and configuration")
Rel(transportAdapters, functionTools, "Invokes stateless resource functions with URI, workspace, and configuration")
Rel(functionTools, projectWorkspace, "Operates on configured or request-specific project files")

Rel(mcpClient, stdioServer, "Exchanges MCP messages", "stdin/stdout")
Rel(mcpClient, statelessServer, "Calls MCP endpoints", "HTTP")
Rel(mcpClient, streamableServer, "Calls MCP endpoints", "streamable HTTP")

SHOW_LEGEND()
@enduml
